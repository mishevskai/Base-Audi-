END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[articleAutoSelection:= _articleAutoSelection;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{39b22ce4-315f-4558-a77c-14cfa8eef7ce}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_articleAutoSelection:= articleAutoSelection;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_init" Id="{c3c391cb-cc51-468e-9f33-3efcc917ff2f}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains 		: BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode 		: BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	EnableStopMode		: BOOL;
	CommonText			: KOSTAL_AF2024_Core_Text.I_Text;
	textPath			: KOSTAL_AF2024_Core_Settings.T_MaxString_UTF8;
	Parameters			: I_Parameters_MainControl;
	Safety				: I_Safety;
	EtherCAT			: I_EtherCAT;
	Fuse				: I_Fuse;
	Logger				: KOSTAL_AF2024_Core_FileLogger.I_Logger;
//	Article				: I_Article;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._enableStopMode:= EnableStopMode;
THIS^._Text.linkCommonText(Common:= CommonText);
THIS^._textPath:= textPath;
THIS^._Iparameters:= Parameters;
THIS^._Isafety:= Safety;
THIS^._IetherCAT:= EtherCAT;
THIS^._IfuseMonitroing:= Fuse;
THIS^._Ilogger:= Logger;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FBmain" Id="{d90a8d2b-1280-4fc2-a1eb-05085edc586a}">
      <Declaration><![CDATA[METHOD PUBLIC FBmain 
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_modeRequest();

IF NOT _parameterControl() THEN RETURN; END_IF
_hmiDefine();
_resetCondition();
_handleAndonLight();

IF NOT _TextReader() THEN RETURN; END_IF

_globalError();
_modeHandler();
_steps();

_onAbortButton(CLK:= DI_AbortButton);]]></ST>
      </Implementation>
    </Method>
