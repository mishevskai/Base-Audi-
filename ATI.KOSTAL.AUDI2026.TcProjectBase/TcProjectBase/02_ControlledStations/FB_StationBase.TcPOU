      <Declaration><![CDATA[METHOD PROTECTED ABSTRACT _steps
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="_temepratureToleranceCheck" Id="{a7c65fd8-dbef-4b7b-827e-a6ecdc3faea0}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _temepratureToleranceCheck  : BOOL
VAR_INPUT
	AnalogInput		: REAL;
	AnalogInputMin	: REAL;
	AnalogInputMax	: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF AnalogInputMin < 0 THEN 
	IF AnalogInput < AnalogInputMin AND AnalogInput < AnalogInputMax THEN 
		_temepratureToleranceCheck:= TRUE;
	ELSE 
		_temepratureToleranceCheck:= FALSE;
	END_IF
ELSE 
	IF AnalogInput > AnalogInputMin AND AnalogInput < AnalogInputMax THEN 
		_temepratureToleranceCheck:= TRUE;
	ELSE 
		_temepratureToleranceCheck:= FALSE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_TextReader" Id="{d4694f16-c80a-4c1f-9a8f-c9e01436b466}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED _TextReader : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Text.Path:= _TextPath;
_Text.FBmain();

IF _text.State.fail THEN
	_updateHmiText(
		userMessage		:= "TextHandler",
		userAction		:= _Text.State.description,
		isErrorMessage	:= TRUE);
ELSIF NOT _Text.Valid THEN
	_updateHmiText(
		userMessage		:= "TextHandler",
		userAction		:= _Text.State.description,
		isErrorMessage	:= FALSE);
END_IF

IF _text.LoadedLanguage <> '' THEN
	_textInitialized := TRUE;
END_IF
_TextReader := _textInitialized;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_updateHmiText" Id="{a4aa925e-cbf8-48e4-baec-95ccc071d54c}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _updateHmiText
VAR_INPUT
	userMessage		: KOSTAL_AF2024_Core_Settings.T_MaxString;
	userAction		: KOSTAL_AF2024_Core_Settings.T_MaxString;
	isErrorMessage	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_message.clear();

_Text.ClearVars();
_Text.AddVar(Text:= INT_TO_WSTRING(_step.actual));
_Text.AddVar(Text:= _stepDescription);
IF (_SubStep.actual = 32767) THEN
	_Text.AddVar(Text:= "0");	
ELSIF (_SubStep.actual <> _SUB_ADDRESS_ABORT) AND (_SubStep.actual <> _SUB_ADDRESS_RETRY_ABORT) THEN
	_Text.AddVar(Text:= INT_TO_WSTRING(_SubStep.actual));
ELSE
	_Text.AddVar(Text:= INT_TO_WSTRING(_lastSubStep));
END_IF
_message.line_01:= _Text.GetText(Number:= _E_TextCommon.step_0_actual_1);
_message.line_02:= userMessage;
_message.line_03:= userAction;
IF isErrorMessage AND NOT _condition.isError() THEN
	_log(Text:= _message.toString());
END_IF

IF isErrorMessage THEN
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
ELSIF (userAction <> "") THEN
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Message,
		message	:= _message);
ELSE
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Text,
		message	:= _message);
END_IF]]></ST>
      </Implementation>
    </Method>
