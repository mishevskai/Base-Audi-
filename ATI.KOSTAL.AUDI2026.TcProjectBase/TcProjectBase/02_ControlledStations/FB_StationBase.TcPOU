	Delimiter	:=  "$L");

_Text.AddVar(Text:= _TextSplitter.Results.line_GET(numberOfLine:= 2));
_subStepMessage:= _Text.GetText(Number:= _E_TextCommon.sensorFail);
	]]></ST>
      </Implementation>
