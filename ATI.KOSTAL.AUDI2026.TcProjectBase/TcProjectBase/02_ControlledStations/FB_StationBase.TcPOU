    <Method Name="_handleCameraMaster" Id="{533bce95-dda9-4f54-b4d2-84dd53ef9ae2}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _handleCameraMaster
VAR_INPUT
	FirstShift 	: INT;
	SecondShift	: INT;
	ThirdShift	: INT;
END_VAR
VAR
	_tempTimeStruct		: Tc2_Utilities.TIMESTRUCT;
	_DT					: DATE_AND_TIME;
	_tempDint			: DINT;
	_isPreviousDay		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_onShiftChange(

	CLK:= 	(WORD_TO_INT(_IgetTime.TimeStruct.Hour) =   FirstShift)//6)

			OR ( WORD_TO_INT(_IgetTime.TimeStruct.Hour) =(SecondShift)) //14)

			OR ( WORD_TO_INT(_IgetTime.TimeStruct.Hour) = (ThirdShift)));//22));

IF _onShiftChange.Q OR NOT _cameraMasterOnStartupDone THEN 

	_IgetTime.TimeStruct.CopyTo(IN:= _tempTimeStruct); 

	_isPreviousDay := FALSE;

	IF (_tempTimeStruct.wHour >= INT_TO_WORD(FirstShift)) AND (_tempTimeStruct.wHour < INT_TO_WORD(SecondShift)) THEN 

		_tempTimeStruct.wHour:= INT_TO_WORD(FirstShift);

	ELSIF (_tempTimeStruct.wHour >= INT_TO_WORD(SecondShift)) AND (_tempTimeStruct.wHour < INT_TO_WORD(ThirdShift)) THEN 

		_tempTimeStruct.wHour:= INT_TO_WORD(SecondShift);

	ELSIF (_tempTimeStruct.wHour >= INT_TO_WORD(ThirdShift)) THEN

		_tempTimeStruct.wHour:= INT_TO_WORD(ThirdShift);

	ELSE 

		_tempTimeStruct.wHour:= INT_TO_WORD(ThirdShift);

		_isPreviousDay := TRUE;

	END_IF

	_tempTimeStruct.wMinute:= 0;

	_tempTimeStruct.wSecond:= 0;

	_tempTimeStruct.wMilliseconds:= 0;

	_DT:= Tc2_Utilities.SYSTEMTIME_TO_DT(TIMESTR:= _tempTimeStruct);

	_tempDint:= DT_TO_DINT(_DT);

	IF _isPreviousDay THEN

		_tempDint	:= _tempDint - 86400;

	END_IF

	IF (_tempDint > _lastCameraMasterTime) THEN 

		_isCameraMasterDone:= FALSE;
		_timeForMaster:= TRUE; 
		_lastCameraMasterTime:= _tempDint;

		_WritePersistentData(START:= TRUE);

	END_IF

	_cameraMasterOnStartupDone:= TRUE;

END_IF
 




//_onShiftChange(
//	CLK:= 	(WORD_TO_INT(_IgetTime.TimeStruct.Hour) =   FirstShift)//6)
//			OR ( WORD_TO_INT(_IgetTime.TimeStruct.Hour) =(SecondShift)) //14)
//			OR ( WORD_TO_INT(_IgetTime.TimeStruct.Hour) = (ThirdShift)));//22));
			
//IF _onShiftChange.Q OR NOT _cameraMasterOnStartupDone THEN 
//	_IgetTime.TimeStruct.CopyTo(IN:= _tempTimeStruct); 
//	IF (_tempTimeStruct.wHour >= INT_TO_WORD(FirstShift)) AND (_tempTimeStruct.wHour < INT_TO_WORD(SecondShift)) THEN 
//		_tempTimeStruct.wHour:= INT_TO_WORD(FirstShift);
//	ELSIF (_tempTimeStruct.wHour >= INT_TO_WORD(SecondShift)) AND (_tempTimeStruct.wHour < INT_TO_WORD(ThirdShift)) THEN 
//		_tempTimeStruct.wHour:= INT_TO_WORD(SecondShift);
//	ELSE 
//		_tempTimeStruct.wHour:= INT_TO_WORD(ThirdShift);
//	END_IF
//	_tempTimeStruct.wMinute:= 0;
//	_tempTimeStruct.wSecond:= 0;
//	_tempTimeStruct.wMilliseconds:= 0;
	
//	_DT:= Tc2_Utilities.SYSTEMTIME_TO_DT(TIMESTR:= _tempTimeStruct);
//	_tempDint:= DT_TO_DINT(_DT);
	
//	IF (_tempDint > _lastCameraMasterTime) THEN 
//		_isCameraMasterDone:= FALSE;
//		_lastCameraMasterTime:= _tempDint;
//		_WritePersistentData(START:= TRUE);
//	END_IF
	
//	_cameraMasterOnStartupDone:= TRUE;
//END_IF]]></ST>
      </Implementation>
    </Method>
