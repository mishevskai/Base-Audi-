    <Method Name="_handleProcessLight" Id="{34c6ce34-b4e1-4dd0-b6ae-c1225c4ebdf8}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _handleProcessLight
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _mainControl.Mode.automatic THEN
	IF _partOk THEN
		DO_ProcessLightGreenLamp:= TRUE;
		DO_ProcessLightRedLamp:= FALSE;
		DO_ProcessLightYellowLamp:= FALSE;
		DO_ProcessLightBlueLamp:= FALSE;
	ELSIF _partNok THEN	
		DO_ProcessLightGreenLamp:= FALSE;
		DO_ProcessLightRedLamp:= TRUE;
		DO_ProcessLightYellowLamp:= FALSE;
		DO_ProcessLightBlueLamp:= FALSE;
	ELSIF _condition.isError() OR _condition.isMessage() THEN
		DO_ProcessLightGreenLamp:= FALSE;
		DO_ProcessLightRedLamp:= FALSE;
		DO_ProcessLightYellowLamp:= FALSE;
		DO_ProcessLightBlueLamp:= TRUE;	
	ELSE
		DO_ProcessLightGreenLamp:= FALSE;
		DO_ProcessLightRedLamp:= FALSE;
		DO_ProcessLightYellowLamp:= TRUE;
		DO_ProcessLightBlueLamp:= FALSE;	
	END_IF	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_hmiDefine" Id="{457ac89e-25b1-4a79-a99e-201386ea0fcd}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL _hmiDefine
VAR
	_temp		: WSTRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Hmi_station.FBmain();
(* Set station name *)
_temp:= TIME_TO_WSTRING(_cycleTime);
_temp:= Tc2_Standard.WRIGHT(
	STR:= _temp,
	SIZE:= Tc2_Standard.WLEN(_temp) - 2);
_Hmi_station.Name:= Tc2_Standard.WCONCAT(
	STR1:= _ID.name,
	STR2:= " [");
_Hmi_station.Name:= Tc2_Standard.WCONCAT(
	STR1:= _Hmi_station.Name,
	STR2:= _temp);
_Hmi_station.Name:= Tc2_Standard.WCONCAT(
	STR1:= _Hmi_station.Name,
	STR2:= "]");
_mainControl.ParticipantName:= _ID.name;
(* Set text lines on Hmi *)
_Hmi_station.Text.line_01:= _condition.Message.line_01;
_Hmi_station.Text.line_02:= _condition.Message.line_02;
_Hmi_station.Text.line_03:= _condition.Message.line_03;
_Hmi_station.Status.CopyFrom(IN:= _condition);
(* Reset button *)
_Hmi_station.Button_Escape.Visible:= _condition.isError() AND _mainControl.Mode.manual;
_Hmi_station.Button_Escape.Text:= _Text.GetText(Number:= _E_TextCommon.reset);
(* Plus button *)
_Hmi_station.Button_Plus.Visible:= _mainControl.Mode.manual AND (_step.actual > _ADDRESS_POWEROFF);
_Hmi_station.Button_Plus.Text:= _Text.GetText(Number:= _E_TextCommon.plus);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_modeHandler" Id="{52dd51d7-d1f6-4ee8-820a-c299494dcab6}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL _modeHandler
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_manualModeInterlock:= _mainControl.Mode.automatic OR NOT _state.Home;
_step.mode.automatic:= _mainControl.Mode.automatic AND NOT _condition.isError() AND NOT _cylinderInManualMode;
_step.mode.manual:= _mainControl.Mode.manual;
_step.StepNumberHome:= _ADDRESS_READY;
_step.LinkManual(
	Forward	:= _Hmi_station.Button_Plus.Pulse,
	Backward:= FALSE);
_step.ManualWithCondition:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_moveCylinderToPossA" Id="{a7ce1a11-d0af-4788-86d0-9d504498c701}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _moveCylinderToPossA : BOOL;
VAR_INPUT
	Cylinder			: I_Cylinder_Controlled;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Cylinder.moveTo_A() THEN 
	_moveCylinderToPossA:= TRUE;
ELSIF Cylinder.Error.active THEN 
	_moveCylinderToPossA:= FALSE;
	_updateHmiTextWithCylinderErrorSensorA(Cylinder:= Cylinder);
ELSE 
	_updateHmiTextWithCylinderTextMoveToHP(Cylinder:= Cylinder);
END_IF
	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_moveCylinderToPossB" Id="{06c8a968-bafd-4de7-8851-abef73fa5da4}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _moveCylinderToPossB : BOOL;
VAR_INPUT
	Cylinder			: I_Cylinder_Controlled;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Cylinder.moveTo_B() THEN 
	_moveCylinderToPossB:= TRUE;
ELSIF Cylinder.Error.active THEN 
	_moveCylinderToPossB:= FALSE;
	_updateHmiTextWithCylinderErrorSensorB(Cylinder:= Cylinder);
ELSE 
	_updateHmiTextWithCylinderTextMoveToWP(Cylinder:= Cylinder);
END_IF
	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_resetCondition" Id="{654a3fbf-b9e2-4b95-becc-14a2deabd9c3}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL _resetCondition
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _condition.isError() THEN
	IF _Hmi_station.Button_Escape.Pulse THEN
		_condition.clear();
	END_IF
ELSE
	_condition.clear();	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_resetTcpIp" Id="{10d9feaf-3ee6-496d-aa9f-c7fb8236b99f}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL _resetTcpIp
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CloseAllSockets(bExecute:= NOT _isTcpIpInit);
_isTcpIpInit:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_retryAbort" Id="{2999e59e-253b-4c6b-b784-c959085e458b}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _retryAbort
VAR_INPUT
	numOfTargetRetries	: INT;
	retryAddress		: INT;
	abortAddress		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Abort button *)
_Hmi_station.Buttons_Custom.Button(7).Visible:= TRUE;
_Hmi_station.Buttons_Custom.Button(7).Text:= _Text.GetText(Number:= _E_TextCommon.abort);
(* Retry button *)
IF (_retryPartsInSeries <= numOfTargetRetries) OR (numOfTargetRetries = _UNLIMITED_RETRY_NUMBER) THEN
	_Hmi_station.Buttons_Custom.Button(1).Visible:= TRUE;
	_Hmi_station.Buttons_Custom.Button(1).Text:= _Text.GetText(Number:= _E_TextCommon.retry);	
	_updateHmiText(
		userMessage		:= _subStepError, 
		userAction		:= _subStepMessage, 
		isErrorMessage	:= TRUE);
ELSE
	_Hmi_station.Buttons_Custom.Button(1).Visible:= FALSE;
	_updateHmiText(
		userMessage		:= _subStepError, 
		userAction		:= _subStepMessage,
		isErrorMessage	:= TRUE);
END_IF

IF (_Hmi_station.Buttons_Custom.Button(1).Pulse OR _onNagaraSwitch.Q) AND _Hmi_station.Buttons_Custom.Button(1).Visible THEN
	_condition.clear();
	_Hmi_station.Buttons_Custom.Button(1).Visible:= FALSE;
	_Hmi_station.Buttons_Custom.Button(7).Visible:= FALSE;
	_SubStep.set(request:= retryAddress);
ELSIF _Hmi_station.Buttons_Custom.Button(7).Pulse OR _IStation.pressedAbortButton THEN //_onAbortButton.Q 
	_condition.clear();
	_Hmi_station.Buttons_Custom.Button(1).Visible:= FALSE;
	_Hmi_station.Buttons_Custom.Button(7).Visible:= FALSE;
	_step.set(request:= abortAddress);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_stepHeader" Id="{d5d502a2-3515-4507-8249-c1beb88abf99}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL _stepHeader
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _isStepInit THEN
	_step.init();
	_isStepInit:= TRUE;
ELSIF _mainControl.Demand.PowerOff AND (_step.actual <> _ADDRESS_POWEROFF) THEN
	_step.init();
END_IF

_step.Header();

(* Reset *)
IF _step.toggle THEN
	_stepDescription:= "";
	_Hmi_station.clear();
	_step.Condition:= FALSE;
	_step.JumpAddress:= 0;
	_SubStep.init();
	_retryPartsInSeries:= 0;
	_addressRestart:= 0;
END_IF
(* Sub step *)
IF (_lastSubStep <> _SubStep.actual) THEN
	_lastSubStep:= _SubStep.actual;
END_IF]]></ST>
      </Implementation>
    </Method>
