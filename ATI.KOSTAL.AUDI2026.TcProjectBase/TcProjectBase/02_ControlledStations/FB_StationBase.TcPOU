<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_StationBase" Id="{47ca1f02-1eb7-4deb-9e35-941fce14d08c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_StationBase EXTENDS KOSTAL_AF2024_Core_Station.FB_Station_Controlled 
VAR PERSISTENT
	_isCameraMasterDone					: BOOL;
	_lastCameraMasterTime				: DINT;	
END_VAR                         		
VAR                             		
	(* General *)  	            		
	_Hmi_station						: KOSTAL_AF2024_HMI_WinHMI.FB_Page_Station;
	_E_TextCommon						: T_E_text_Common;
	_IgetTime							: KOSTAL_AF2024_Core_GetSystemTime.I_TimeSource;
	_isDevicesInit						: BOOL;
	_cylinderInManualMode				: BOOL;
	_manualModeInterlock				: BOOL;
	_onPowerOff							: Tc2_Standard.R_TRIG;
	_onNagaraSwitch						: Tc2_Standard.R_TRIG;
//	_onAbortButton						: Tc2_Standard.R_TRIG;
	_timerCycleTimer					: Tc2_Standard.TON;
	_addressRestart						: INT;
	_tempText							: KOSTAL_AF2024_Core_Settings.T_MaxString_UTF8;
	_isHomeControkOk					: BOOL;
	_TextSplitter						: KOSTAL_AF2024_Core_StringTools.FB_Split;
	_cycleTime							: TIME;
	_CloseAllSockets					: Tc2_TcpIp.FB_SocketCloseAll;
	_isTcpIpInit						: BOOL;
	_WritePersistentData				: Tc2_Utilities.WritePersistentData;
	(* Camera master *)         		
	_onShiftChange						: Tc2_Standard.R_TRIG;
	_cameraMasterOnStartupDone			: BOOL;
	_isCameraMasterBadPartDone			: BOOL;
	_isCameraMasterGoodPartDone			: BOOL;
	_timeForMaster						: BOOL; 
	(* Process *)               		
	_isStepInit							: BOOL;
	_onStateHome						: Tc2_Standard.R_TRIG;
	_SubStep							: KOSTAL_AF2024_Core_Process.FB_processStep_Flow;
	_lastSubStep						: INT;
	_stepDescription					: KOSTAL_AF2024_Core_Settings.T_MaxString;
	_subStepError						: KOSTAL_AF2024_Core_Settings.T_MaxString;
	_subStepMessage						: KOSTAL_AF2024_Core_Settings.T_MaxString;
	_onSubStepRetryAbort				: Tc2_Standard.R_TRIG;
	_retryPartsInSeries					: INT;
	_partOk								: BOOL;
	_partNok							: BOOL;
	(* Interface *)             		
	_IresettableCounter					: KOSTAL_AF2024_Misc_Counter.I_T_CounterSet;
	_ItotalCounter						: KOSTAL_AF2024_Misc_Counter.I_T_CounterSet;
	_IparametersBase					: I_Parameters_MainControl;
	_IStation							: I_CustomStationInterface; 
	(* Sensors *)
	DI_NagaraSwitch				 AT %I* : BOOL; 
//	DI_AbortButton				 AT %I* : BOOL;
	(* Process Light *)
	DO_ProcessLightGreenLamp	 AT %Q* : BOOL;
	DO_ProcessLightRedLamp		 AT %Q* : BOOL;
	DO_ProcessLightYellowLamp	 AT %Q* : BOOL;
	DO_ProcessLightBlueLamp		 AT %Q* : BOOL;
	(* IX camera *)
	 _InternalResponse					: TcNexa_Components_TcProcess.FB_MethodResponse;
	(* SPC counter *)
	_counterForSCPmode					: INT;
	_isSPCmodeActive					: BOOL;
END_VAR
VAR CONSTANT
	(* Step *)
	_ADDRESS_POWEROFF					: INT:= 0;
	_ADDRESS_READY						: INT:= 30;	
	_ADDRESS_PASS						: INT:= 100;
	_ADDRESS_FAIL						: INT:= 200;
	_ADDRESS_SPCMODE					: INT:= 300;
	_ADDRESS_RUNOUT						: INT:= 350;
	_ADDRESS_CAMERA_MASTER				: INT:= 400;
	
	(* Sub Step *)              		
	_SUB_ADDRESS_PASS					: INT:= 600;
	_SUB_ADDRESS_RETRY_ABORT			: INT:= 700;
	_SUB_ADDRESS_ABORT					: INT:= 800;
	(* General *)               		
	_UNLIMITED_RETRY_NUMBER				: INT:= -1;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Abstract " Id="{a32705d4-546e-4f66-982c-0b36578c4f36}" />
