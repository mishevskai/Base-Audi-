      <Declaration><![CDATA[METHOD INTERNAL _handleCycleTime
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_cycleTime <> _timerCycleTimer.ET) AND (_timerCycleTimer.ET <> T#0MS) THEN
	_cycleTime:= _timerCycleTimer.ET;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_handleManualModeStepDoneMessage" Id="{a1910d53-49d5-48dd-8c98-7c64d4973afd}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL _handleManualModeStepDoneMessage
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _SubStep.isActive(stepNumber:= _SUB_ADDRESS_PASS) THEN
	_updateHmiText(
		userMessage		:= _Text.GetText(Number:= _E_TextCommon.stepDone),
		userAction		:= _Text.GetText(Number:= _E_TextCommon.stepContinue),
		isErrorMessage	:= FALSE);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_handlePersistentData" Id="{c594721d-bb66-4b3c-9240-e3fda0f990d8}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD _handlePersistentData
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_WritePersistentData(
	NETID	:= '',
	PORT	:= 851,
	START	:= FALSE,
	TMOUT	:= Tc2_System.DEFAULT_ADS_TIMEOUT);]]></ST>
      </Implementation>
