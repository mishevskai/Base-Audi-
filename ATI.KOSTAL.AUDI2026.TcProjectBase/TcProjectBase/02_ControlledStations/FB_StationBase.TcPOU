    <Method Name="_a2_X_CognexCameraTrigerTCPIP" Id="{b77504bc-0dcc-477f-b421-a7cd9b78acb7}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_CognexCameraTrigerTCPIP : BOOL
VAR_INPUT
	Camera				 : KOSTAL_AF2024_Drivers_Camera_Cognex_InSight.I_InSight_TcpIp;
	targetProgramNum	 : UINT;
	isCameraEnable		 : BOOL;
	cameraName			 : STRING;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_stepDescription:= "CognexCameraCheck";
END_IF

(* Check Camera Ready *)
IF _SubStep.isActive(0) THEN 
	_addressRestart:= _SubStep.actual;
	IF NOT isCameraEnable THEN 
		_a2_X_CognexCameraTrigerTCPIP:= TRUE;
//		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	ELSIF NOT Camera.State.ready THEN 
		_updateHmiTextWithCameraNotReady(name:= STRING_TO_WSTRING( cameraName));
	ELSE 
		_addressRestart:= _SubStep.actual;
		_SubStep.INC();
	END_IF
END_IF
(* Camera triger *) //Ima program number i program name 
IF _SubStep.isActive(1) THEN 
	IF NOT Camera.Ex_Trigger_ProgramNumber(ProgramNumber:= targetProgramNum) THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(cameraName));
	ELSIF NOT Camera.State.finish THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(cameraName));
	ELSIF NOT Camera.State.pass THEN 
		_getCameraErrorTexts(
			name		:= STRING_TO_WSTRING( cameraName),
			description	:= Camera.State.description);
		_a2_X_CognexCameraTrigerTCPIP:= FALSE;
//		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE 
//		_SubStep.set(request:= _SUB_ADDRESS_PASS);
		_a2_X_CognexCameraTrigerTCPIP:= TRUE;
	END_IF
END_IF

(* Pass *)
//IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
////	_step.Condition:= TRUE;
//	_SubStep.INC();
//END_IF
(* Fail *)
//IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
//	_retryAbort(
//		numOfTargetRetries	:= _IparametersBase.numberOfRetries, 
//		retryAddress		:= _addressRestart, 
//		abortAddress		:= _ADDRESS_RUNOUT);
//END_IF

//_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_CognexReaderScanCode" Id="{26fe27ba-9e77-48bd-bd9f-b06424832250}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_CognexReaderScanCode
VAR_INPUT
	Scanner			: KOSTAL_AF2024_Drivers_Scanner_Cognex_DM260.I_Scanner;
	isScanerEnable	: BOOL;
END_VAR
VAR_OUTPUT
	SFC				: KOSTAL_AF2024_Core_Settings.T_MaxString_UTF8;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Da se proba dali kje raboti vaka ako ne kje treba enable na nekoj setting da se napravi 
//Ili tcp ip 

IF _step.toggle THEN 
	_stepDescription:= "ScanCode";
END_IF

(* Wait until scanner is ready *)
IF _SubStep.isActive(0) THEN 
	_addressRestart:= _SubStep.actual;
	IF NOT isScanerEnable THEN 
		SFC:= '';
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	ELSIF NOT Scanner.State.ready THEN 
		_Text.ClearVars();
		_text.AddVar("41A1");
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_failed),
			userAction		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_notReady),
			isErrorMessage	:= FALSE);
	ELSE 
		_SubStep.INC();
	END_IF
END_IF

(* Execute *)
IF _SubStep.isActive(1) THEN 
	IF NOT Scanner.Ex_Scan() THEN 
		_Text.ClearVars();
		_text.AddVar("41A1");
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_busy),
			userAction		:= "",
			isErrorMessage	:= FALSE);
	ELSIF NOT Scanner.State.finish THEN 
		_Text.ClearVars();
		_text.AddVar("41A1");
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_busy),
			userAction		:= "",
			isErrorMessage	:= FALSE);
	ELSIF NOT Scanner.State.pass THEN 
		_Text.ClearVars();
		_text.AddVar("41A1");
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_inError),
			userAction		:= Scanner.State.description,
			isErrorMessage	:= FALSE);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSIF (Scanner.CodeGet(1) = '') OR (Scanner.CodeGet(1) = 'ERROR') OR (Scanner.CodeGet(1) = 'NONE') THEN 
		_Text.ClearVars();
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_failed),
			userAction		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_noCode),
			isErrorMessage	:= FALSE);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE 
		_SubStep.set(request:= _SUB_ADDRESS_PASS);	
	END_IF
END_IF

(* Pass *) 
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN 
	SFC:= Scanner.CodeGet(number:= 1);
	_step.Condition:= TRUE;
END_IF
(* Fail - Retry/Abort *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _IparametersBase.numberOfRetries,
		retryAddress		:= _addressRestart, 
		abortAddress		:= _ADDRESS_FAIL);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_KeyenceIVCameraTrigerDIO" Id="{565ad191-7bc0-4e7a-8e9e-e728ff53b17a}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_KeyenceIVCameraTrigerDIO : BOOL 
VAR_INPUT
	camera					 : KOSTAL_AF2024_Drivers_Camera_I_Camera.I_CameraWithFeedback; 
	targetProgramNum		 : UINT;
	cameraName				 : STRING;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_stepDescription:= "TigerCameraKeyneceDIO";
END_IF

(* CheckCameraReady? *)
IF _SubStep.isActive(0) THEN 
	_addressRestart:= _SubStep.actual;
END_IF

(* Camera triger *)
IF _SubStep.isActive(1) THEN 
	IF NOT Camera.Ex_Trigger_ProgramNumber(ProgramNumber:= targetProgramNum) THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(cameraName));
	ELSIF NOT Camera.State.finish THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(cameraName));
	ELSIF NOT Camera.State.pass THEN 
		_getCameraErrorTexts(
			name		:= STRING_TO_WSTRING(cameraName),
			description	:= Camera.State.description);
		_a2_X_KeyenceIVCameraTrigerDIO:= FALSE;
	ELSE 
		_a2_X_KeyenceIVCameraTrigerDIO:= TRUE;
	END_IF
END_IF

//(* Pass *)
//IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
//	_step.Condition:= TRUE;
//END_IF

//_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_KeyenceIXCameraTriger" Id="{12f0d344-41a2-45bd-9b6e-5d65eb8a958e}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_KeyenceIXCameraTriger : BOOL
VAR_INPUT
	Camera					 : TcNexa_Devices_Camera_TcCamera.I_Camera;
	IXtargerProgramNum	 	 : UINT;
	isIXcameraEnable		 : BOOL;
	IXcameraName			 : KOSTAL_AF2024_Core_Settings.T_MaxString_UTF8;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_stepDescription:= "IXCameraCheck";
END_IF

(*Chech parameters *)
IF _SubStep.isActive(0) THEN 
	IF NOT isIXcameraEnable THEN 
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	ELSE 
		_SubStep.INC();
	END_IF
END_IF
(* Set program number *)
IF _SubStep.isActive(0) THEN 
	Camera.setProgramNumber(
		programNumber:= IXtargerProgramNum,
		Response:= _InternalResponse);
	IF _InternalResponse.busy THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(IXcameraName));
	ELSE 
		_SubStep.INC(); 
	END_IF
END_IF 
(* Triger camera *)
IF _SubStep.isActive(2) THEN 
	Camera.inspect(Response:= _InternalResponse);
	IF _InternalResponse.busy THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING( IXcameraName));
	ELSIF _InternalResponse.error THEN
//		_a2_X_KeyenceIXCameraTriger:= FALSE; 
		_getCameraErrorTexts(
			name:= STRING_TO_WSTRING(IXcameraName),
			description:= _Text.GetText(Number:= _E_TextCommon.camera_0_inError));
		_updateHmiText(
			userMessage:= STRING_TO_WSTRING( IXcameraName), 
			userAction:=  _Text.GetText(Number:= _E_TextCommon.camera_0_inError),
			isErrorMessage:= FALSE); 
	ELSE 
		_a2_X_KeyenceIXCameraTriger:= TRUE;
	END_IF
END_IF
(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.Condition:= TRUE;
END_IF

_step.Control();

]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_KeyenceScanCode" Id="{49acc7f6-58ae-4c27-90bc-696f74fed5c1}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_KeyenceScanCode
VAR_INPUT
	Scanner				: KOSTAL_AF2024_Drivers_Scanner_IScanner.I_Scanner;
	isScannerEnable		: BOOL;
	ScannerName			: KOSTAL_AF2024_Core_Settings.T_MaxString;
END_VAR
VAR_OUTPUT
	SFC					: KOSTAL_AF2024_Core_Settings.T_MaxString_UTF8;
END_VAR
VAR 
	_tempInterger		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_stepDescription:= "ScanHousing";
	Scanner.ClearCodes();
END_IF

(* wait until scanner is ready *)
IF _SubStep.isActive(0) THEN 
	_addressRestart:= _SubStep.actual;
	IF NOT isScannerEnable THEN 
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
		SFC:= '';
	ELSIF NOT Scanner.State.ready THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= ScannerName);
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_failed),
			userAction		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_notReady),
			isErrorMessage	:= FALSE);
	ELSE 
		_SubStep.INC();
	END_IF
END_IF
(* Execute *)
IF _SubStep.isActive(1) THEN 
	IF NOT Scanner.Ex_Scan() THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= ScannerName);
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_busy),
			userAction		:= "",
			isErrorMessage	:= FALSE);	
	ELSIF NOT Scanner.State.finish THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= ScannerName);
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.scanner_0_busy),
			userAction		:= "",
			isErrorMessage	:= FALSE);	
	ELSIF NOT Scanner.State.pass THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= ScannerName);
		_retryPartsInSeries:= _retryPartsInSeries+1 ;
		_subStepError:= _Text.GetText(Number:= _E_TextCommon.scanner_0_inError);
		_subStepMessage:= Scanner.State.description;
		_SubStep.set(request:= _SUB_ADDRESS_ABORT);
	ELSIF (Scanner.CodeGet(1) = '') OR (Scanner.CodeGet(1) = 'NONE') OR (Scanner.CodeGet(1) = 'Error') THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= ScannerName);
		_retryPartsInSeries:= _retryPartsInSeries+1 ;
			_subStepError:= _Text.GetText(Number:= _E_TextCommon.scanner_0_failed);
			_subStepMessage:= _Text.GetText(Number:= _E_TextCommon.barcodeNotfound);
			_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE 
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	END_IF
END_IF


(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	SFC:= Scanner.CodeGet(number:= 1);
	_step.Condition:= TRUE;
END_IF
(* Fail - Retry/Abort *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _IparametersBase.numberOfRetries, 
		retryAddress		:= _addressRestart, 
		abortAddress		:= _ADDRESS_RUNOUT);
END_IF
(* Fail *)
IF _SubStep.isActive(_SUB_ADDRESS_ABORT) THEN
	_abort(abortAddress:= _ADDRESS_RUNOUT);
END_IF

_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_LockPart" Id="{965d9ee1-7fb6-4a5e-8ed8-4e49d18148dd}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_LockPart
VAR_INPUT
	Cylinder		: KOSTAL_AF2024_Drivers_Actuation_Cylinder.I_Cylinder_Controlled;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_stepDescription:= "LockHousing";
END_IF

(* Lock Housing *)
IF _SubStep.isActive(0) THEN
	IF Cylinder.moveTo_B() THEN
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	ELSIF Cylinder.Error.active THEN
		_subStepMessage:= Cylinder.Error.text;
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE
		_updateHmiTextWithCylinderTextMoveToWP(Cylinder:= Cylinder);
	END_IF
END_IF

(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.Condition:= TRUE;
END_IF
(* Fail *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _UNLIMITED_RETRY_NUMBER, 
		retryAddress		:= _addressRestart, 
		abortAddress		:= _ADDRESS_RUNOUT);
END_IF

_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_PartNok" Id="{ca30d499-ad6b-4d44-ae6d-89ea3338c349}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_PartNok
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	IF (_IresettableCounter <> 0) THEN _IresettableCounter.Fail.INC(); END_IF
	IF (_ItotalCounter <> 0) THEN _ItotalCounter.Fail.INC(); END_IF
	_partNok:= TRUE;
	_stepDescription:= "Part NOK";
	_subStepError:= "Part NOK";
	_subStepMessage:= "";
END_IF

_abort(abortAddress:= _ADDRESS_RUNOUT);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_PartOkWithCounter" Id="{b60392eb-f161-41c1-b213-ba6b8337f08d}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_PartOkWithCounter
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_IresettableCounter <> 0) THEN _IresettableCounter.Pass.INC(); END_IF
IF (_ItotalCounter <> 0) THEN _ItotalCounter.Pass.INC(); END_IF
_partOk:= TRUE;
_step.set(request:= _ADDRESS_RUNOUT);

]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_PartOkWithoutCounter" Id="{223e47b5-238f-42e8-8c47-382050c789f3}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_PartOkWithoutCounter
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_partOk:= TRUE;
_step.set(request:= _ADDRESS_RUNOUT);

]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_RemovePart" Id="{62f7f17d-9122-40ec-8a3c-b891cb6c4df6}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_RemovePart
VAR_INPUT
	partDetected		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_stepDescription:= "RemovePart";
END_IF

IF _partOk THEN
	_updateHmiText(
		userMessage		:= _Text.GetText(Number:= _E_TextCommon.partOk),
		userAction		:= _Text.GetText(Number:= _E_TextCommon.removePart),
		isErrorMessage	:= FALSE);
ELSIF _partNok THEN
	_updateHmiText(
		userMessage		:= _Text.GetText(Number:= _E_TextCommon.partNok),
		userAction		:= _Text.GetText(Number:= _E_TextCommon.removePart),
		isErrorMessage	:= FALSE);
ELSE
	_updateHmiText(
		userMessage		:= _Text.GetText(Number:= _E_TextCommon.partUnknown),
		userAction		:= _Text.GetText(Number:= _E_TextCommon.removePart),
		isErrorMessage	:= FALSE);
END_IF

_step.Condition:= NOT partDetected;
_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_TrigerCameraKeyenceTcpIp" Id="{319c9760-e9da-401d-a067-4456ce94a849}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_TrigerCameraKeyenceTcpIp : BOOL
VAR_INPUT
	Camera					 : KOSTAL_AF2024_Drivers_Camera_Keyence_IV.I_Camera_TcpIp_IV;
	targerProgramNum		 : UINT;
	isCameraEnable			 : BOOL;
	cameraName				 : STRING;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_stepDescription:= "TigerCameraKeynece";
END_IF

(* CheckCameraReady? *)
IF _SubStep.isActive(0) THEN 
	_addressRestart:= _SubStep.actual;
	IF NOT isCameraEnable THEN 
//		_SubStep.set(request:= _SUB_ADDRESS_PASS);
		_a2_X_TrigerCameraKeyenceTcpIp:= TRUE;
	ELSIF NOT Camera.State.ready THEN 
		_updateHmiTextWithCameraNotReady(name:= STRING_TO_WSTRING (cameraName));
	ELSE 
		_SubStep.INC();
	END_IF
END_IF

(* Camera triger *)
IF _SubStep.isActive(1) THEN 
	IF NOT Camera.Ex_Trigger_ProgramNumber(ProgramNumber:= targerProgramNum) THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(cameraName));
	ELSIF NOT Camera.State.finish THEN 
		_updateHmiTextWithCameraBusy(name:= STRING_TO_WSTRING(cameraName));
	ELSIF NOT Camera.State.pass THEN 
		_a2_X_TrigerCameraKeyenceTcpIp:= FALSE;
		_getCameraErrorTexts(
			name		:= STRING_TO_WSTRING(cameraName),
			description	:= Camera.State.description);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE 
//		_SubStep.set(request:= _SUB_ADDRESS_PASS);
		_a2_X_TrigerCameraKeyenceTcpIp:= TRUE;
	END_IF
END_IF

(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.INC();
END_IF
(* Fail *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _IparametersBase.numberOfRetries, 
		retryAddress		:= _addressRestart, 
		abortAddress		:= _ADDRESS_RUNOUT); //Check or address runout  ?
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_UnlockPart" Id="{7f21309f-fd74-460e-a12a-fe31325c3c27}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_UnlockPart
VAR_INPUT
	Cylinder		: KOSTAL_AF2024_Drivers_Actuation_Cylinder.I_Cylinder_Controlled;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_stepDescription:= "UnlockHousing";
END_IF

(* Unlock Housing *)
IF _SubStep.isActive(0) THEN
	IF Cylinder.moveTo_A() THEN
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	ELSIF Cylinder.Error.active THEN
		_addressRestart:= _SubStep.actual;
		_getCylinderErrorTexts(Cylinder:= Cylinder);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE
		_updateHmiTextWithCylinderTextMoveToHP(Cylinder:= Cylinder);
	END_IF
END_IF
(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.Condition:= TRUE;
END_IF
(* Fail *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _UNLIMITED_RETRY_NUMBER, 
		retryAddress		:= _addressRestart, 
		abortAddress		:= _step.actual);
END_IF

_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_abort" Id="{fbe025fd-5ae9-4e21-940f-a463da82b848}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _abort
VAR_INPUT
	abortAddress		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Abort button *)
_Hmi_station.Buttons_Custom.Button(7).Visible:= TRUE;
_Hmi_station.Buttons_Custom.Button(7).Text:= _Text.GetText(Number:= _E_TextCommon.abort);

_updateHmiText(
	userMessage		:= _subStepError, 
	userAction		:= _subStepMessage, 
	isErrorMessage	:= TRUE);

IF _Hmi_station.Buttons_Custom.Button(7).Pulse OR _IStation.pressedAbortButton  THEN //_onAbortButton.Q
	_condition.clear();
	_Hmi_station.Buttons_Custom.Button(7).Visible:= FALSE;
	_step.set(request:= abortAddress);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_checkCounterSPC" Id="{fa596519-fe6a-4cab-983c-f73cf5c554b9}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _checkCounterSPC
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_stepDescription:= "SpcCounterCheck";
END_IF

IF _SubStep.isActive(0) THEN 
	_counterForSCPmode:= _counterForSCPmode+1; 
	IF _counterForSCPmode > 5 THEN 
		_counterForSCPmode:= 0;
		_isSPCmodeActive:= FALSE;
		_step.set(request:= _ADDRESS_READY);
	ELSE 
		_isSPCmodeActive:= TRUE; 
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	END_IF
END_IF 

(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.Condition:= TRUE;
END_IF

_step.Control();]]></ST>
      </Implementation>
    </Method>
