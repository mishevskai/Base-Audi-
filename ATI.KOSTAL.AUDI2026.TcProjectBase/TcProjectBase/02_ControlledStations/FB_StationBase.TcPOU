      <Implementation>
        <ST><![CDATA[_TextSplitter.Clear();
_TextSplitter.Split_Delimiter(
	Line		:= Cylinder.Name.device,
	Delimiter	:=  "$L");

_Text.ClearVars();
_Text.AddVar(Text:= _TextSplitter.Results.line_GET(numberOfLine:= 1));
