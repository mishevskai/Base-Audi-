    <Method Name="FBmain" Id="{f0537eaf-7f7e-4cfa-9a96-e14fba530749}">
      <Declaration><![CDATA[METHOD FBmain
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _parameterControl() THEN RETURN; END_IF

_onStateHome(CLK:= _state.Home);

_hmiDefine();
_resetTcpIp();
_deviceDefine();
_resetCondition();

IF NOT _TextReader() THEN RETURN; END_IF

_globalError();
_globalMessage();
_modeHandler();
_stepHeader();
_steps();
_handleProcessLight();
_handleCycleTime();
_handleManualModeStepDoneMessage();
//_handleCameraMaster(); //DA se definira lokalno ne vo baza
_handlePersistentData();
_onPowerOff(CLK:= _state.PowerOff);
_onNagaraSwitch(CLK:= DI_NagaraSwitch);
//_onAbortButton(CLK:= DI_AbortButton);
_onSubStepRetryAbort(CLK:= (_SubStep.actual = _SUB_ADDRESS_RETRY_ABORT));
IF _onSubStepRetryAbort.Q THEN
	_retryPartsInSeries:= _retryPartsInSeries + 1;
END_IF

_isDevicesInit:= TRUE;]]></ST>
      </Implementation>
    </Method>
