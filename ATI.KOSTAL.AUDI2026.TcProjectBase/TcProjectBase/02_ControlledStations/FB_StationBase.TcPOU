    <Method Name="_a2_030_Ready" Id="{58bb5520-7496-4af0-97a0-fbfb67b6e725}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_030_Ready
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_partOk:= FALSE;
	_partNok:= FALSE;
	_state.SetUnique_Home();
	_stepDescription:= "Ready";
END_IF

_isHomeControkOk:= _a2_030_Ready_HomeControl();

(* Machine is in stop state *)
IF NOT _mainControl.Demand.Run THEN
	_Text.ClearVars();
	_Text.AddVar(Text:= _Text.GetText(Number:= _E_TextCommon.stop));
	_updateHmiText(
		userMessage		:= _Text.GetText(Number:= _E_TextCommon.mainControlIsIn_0_state), 
		userAction		:= "", 
		isErrorMessage	:= FALSE);
ELSIF _cylinderInManualMode THEN
	_updateHmiText(
		userMessage		:= _Text.GetText(Number:= _E_TextCommon.stationInManualMode), 
		userAction		:= _Text.GetText(Number:= _E_TextCommon.cylinderInManualMode), 
		isErrorMessage	:= FALSE);
ELSIF _isHomeControkOk THEN
	_a2_030_Ready_ConditionControl();
END_IF

_step.Control();

IF _step.Done THEN
	_state.SetUnique_Busy();
END_IF]]></ST>
      </Implementation>
    </Method>
