    <Method Name="_a0_Fail" Id="{023acf6e-f0d6-4b9b-b2b4-f11048adf6dc}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a0_Fail
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Text.ClearVars();
_Text.AddVar(Text:= INT_TO_WSTRING(_step.actual));

_message.clear();
_message.line_01:= _Text.GetText(Number:= _E_TextCommon.step_0_DoesNotExist);
_condition.setMessage(
	priority	:= _condition.PriorityLevel_Error + 1000,
	message		:= _message);
_log(Text:= _message.toString());]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a1_000_PowerOff" Id="{c77377fa-8dfd-419c-834c-58377bb3d47b}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a1_000_PowerOff
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_Hmi_station.clear();
	_log(Text:= _Text.GetText(Number:= _E_TextCommon.off));
	_state.SetUnique_PowerOff();
	_stepDescription:= "PowerOff";
END_IF

_condition.clear();
_message.clear();
_Hmi_station.clear_controls();

_updateHmiText(
	userMessage		:= _Text.GetText(Number:= _E_TextCommon.off), 
	userAction		:= "", 
	isErrorMessage	:= FALSE);

IF _mainControl.Demand.PowerOn THEN
	_log(Text:= _Text.GetText(Number:= _E_TextCommon.on));
	_step.INC();
ELSIF _Hmi_station.Button_OnOff.Pulse THEN
	;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a1_001_PowerOn" Id="{815546fd-472e-48eb-965a-70c7dce13cb4}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a1_001_PowerOn
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_state.SetUnique_PowerOn();
	_stepDescription:= "PowerOn";
END_IF

_updateHmiText(
	userMessage		:= _Text.GetText(Number:= _E_TextCommon.on), 
	userAction		:= "", 
	isErrorMessage	:= FALSE);

IF _mainControl.Demand.OnToHome THEN
	_step.Condition:= TRUE;
END_IF

_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a1_X_Finish" Id="{75fe071e-ccc6-4e08-85ac-5831f5f3c69e}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a1_X_Finish
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_state.SetUnique_Finish();
END_IF

_step.set(request:= _ADDRESS_READY);]]></ST>
      </Implementation>
    </Method>
