<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_StationBaseWithAutomaticSlider" Id="{18e9245b-0cb1-4a5a-b8f8-6f1536abc090}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_StationBaseWithAutomaticSlider EXTENDS FB_StationBase
VAR
	(* Slider Automatic Cylinder *)
	_SliderAutomaticCylinder 				   : KOSTAL_AF2024_Drivers_Actuation_Cylinder.FB_Cylinder_Controlled;
	DI_SliderAutomaticCylinderHP		AT %I* : BOOL;
	DI_SliderAutomaticCylinderWP		AT %I* : BOOL;
	DO_SliderAutomaticCylinderWP		AT %Q* : BOOL;
	DO_SliderAutomaticCylinderHP		AT %Q* : BOOL;
	
	(* Slider Locking Cylinder Front Position *)
	_SliderLockingCylinderFrontPosition		: KOSTAL_AF2024_Drivers_Actuation_Cylinder.FB_Cylinder_Controlled;
	DO_SliderLockCylinderFrontPosHP		AT %Q* : BOOL; // Treba da se vidi koi sensori bi se koristele ovde 
	DO_SliderLockCylinderFrontPosWP		AT %Q* : BOOL;
	DI_SliderLockCylinderFrontPosWP		AT %I* : BOOL;
	DI_SliderLockCylinderFrontPosHP		AT %I* : BOOL;
	DI_SliderInFrontPos					AT %I* : BOOL;
	DI_SliderInBackPos					AT %I* : BOOL;
	
	(* Process *)
	_timerSliderInBackPos						: Tc2_Standard.TON;
	_timerSliderInFrontPos						: Tc2_Standard.TON;
	
	(* Names *)
	_automaticSliderInFrontPositionName 	: KOSTAL_AF2024_Core_Settings.T_MaxString;
	_automaticSliderInBackPositionName 	: KOSTAL_AF2024_Core_Settings.T_MaxString;
	_isHomeDone					: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="ITFs" Id="{ab59b50a-7d22-4e67-90d9-fbf0d513c651}" />
    <Folder Name="Property " Id="{dddc2454-bdf3-4591-a9d6-406ce2c9e3a3}" />
    <Folder Name="Steps" Id="{2a44b4ac-ff55-4cb6-ac5e-be2eeba8a8d1}" />
    <Folder Name="System " Id="{771568eb-cb54-41be-a930-1d2514913fa3}" />
    <Method Name="_a2_X_CloseAutomaticSlider" Id="{e283b0ad-a1c0-4d3e-a425-ad125e19cff1}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_CloseAutomaticSlider
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN
	_timerSliderInFrontPos(IN:= FALSE);
	_stepDescription:= "SliderUnlockFrontPosition"; 
END_IF

(* If slider in front position skip this step *)
IF _SubStep.isActive(0) THEN 
	IF DI_SliderAutomaticCylinderWP THEN 
		_SubStep.set(request:= 4);
	ELSE 
		_SubStep.INC();
	END_IF
END_IF 
(* Unlock *)
IF _SubStep.isActive(1) THEN 
	IF _SliderLockingCylinderFrontPosition.moveTo_A() THEN 
		_SubStep.INC();
	ELSIF  _SliderLockingCylinderFrontPosition.Error.active THEN 	
		_updateHmiTextWithCylinderError(Cylinder:= _SliderLockingCylinderFrontPosition);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE 
		_updateHmiTextWithCylinderTextMoveToHP(Cylinder:= _SliderLockingCylinderFrontPosition);
	END_IF
END_IF
(* Move Automatic Slider Cylinder in front position*)
IF _SubStep.isActive(2) THEN 
	IF _SliderAutomaticCylinder.moveTo_B() THEN 
		_SubStep.INC();
	ELSIF _SliderAutomaticCylinder.Error.active THEN 
		_updateHmiTextWithCylinderError(Cylinder:= _SliderAutomaticCylinder);
	ELSE 
		_updateHmiTextWithCylinderTextMoveToWP(Cylinder:= _SliderAutomaticCylinder);
	END_IF
END_IF
(* Wait slider in back position *)
IF _SubStep.isActive(3) THEN 
	_timerSliderInFrontPos(
		IN	:= DI_SliderAutomaticCylinderWP,
		PT	:= T#500MS); //T#500MS
	IF NOT _timerSliderInFrontPos.Q THEN  
		_Text.ClearVars();
		_Text.AddVar(Text:= _automaticSliderInFrontPositionName);
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.waitSliderInFrontPosition),
			userAction		:= _Text.GetText(Number:= _E_TextCommon.waitForSensor_0),
			isErrorMessage	:= FALSE);	
	ELSIF  DI_SliderAutomaticCylinderWP  THEN 
		_SubStep.INC();
	END_IF	
END_IF
(* Lock *)
IF _SubStep.isActive(4) THEN
	IF _SliderLockingCylinderFrontPosition.moveTo_B() THEN
		_SliderAutomaticCylinder.Pressureless();
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	ELSIF _SliderLockingCylinderFrontPosition.Error.active THEN
		_addressRestart:= _SubStep.actual;
		_getCylinderErrorTexts(Cylinder:= _SliderLockingCylinderFrontPosition);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE
		_updateHmiTextWithCylinderTextMoveToWP(Cylinder:= _SliderLockingCylinderFrontPosition);
	END_IF
END_IF
(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.Condition:= TRUE;
END_IF
(* Fail *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _UNLIMITED_RETRY_NUMBER,
		retryAddress		:= _addressRestart,
		abortAddress		:= _ADDRESS_RUNOUT);
END_IF

_step.Control();



]]></ST>
      </Implementation>
    </Method>
    <Method Name="_a2_X_OpenAutomaticSlider" Id="{c7d05e38-2d21-465b-a93e-008f1468a6e7}" FolderPath="Steps\">
      <Declaration><![CDATA[METHOD PROTECTED _a2_X_OpenAutomaticSlider
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _step.toggle THEN 
	_timerSliderInBackPos(IN:= FALSE);
	_stepDescription:= "CloseAutomaticSlider";
END_IF
(* If slider in back position skip this step *)
IF _SubStep.isActive(0) THEN 
	IF DI_SliderAutomaticCylinderHP THEN 
		_SubStep.set(request:=3);
	ELSE 
		_SubStep.INC();
	END_IF
END_IF 
(* Unlock *)
IF _SubStep.isActive(1) THEN 
	IF _SliderLockingCylinderFrontPosition.moveTo_A() THEN 
		_SubStep.INC();
	ELSIF  _SliderLockingCylinderFrontPosition.Error.active THEN 
		_updateHmiTextWithCylinderError(Cylinder:= _SliderLockingCylinderFrontPosition);
		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
	ELSE 
		_updateHmiTextWithCylinderTextMoveToHP(Cylinder:= _SliderLockingCylinderFrontPosition);
	END_IF
END_IF
(* Move Automatic Slider Cylinder in back position*)
IF _SubStep.isActive(2) THEN 
	IF _SliderAutomaticCylinder.moveTo_A() THEN 
		_SubStep.INC();
	ELSIF _SliderAutomaticCylinder.Error.active THEN 
		_updateHmiTextWithCylinderError(Cylinder:= _SliderAutomaticCylinder);
	ELSE 
		_updateHmiTextWithCylinderTextMoveToWP(Cylinder:= _SliderAutomaticCylinder);
	END_IF
END_IF
(* Wait slider in back position *)
IF _SubStep.isActive(3) THEN 
	_timerSliderInBackPos(
		IN:=   DI_SliderAutomaticCylinderHP,
		PT:=   T#500MS 	);//500ms da se doddade
	IF NOT DI_SliderAutomaticCylinderHP THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= _automaticSliderInBackPositionName);
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.waitSliderInBackPosition),
			userAction		:= _Text.GetText(Number:= _E_TextCommon.waitForSensor_0),
			isErrorMessage	:= FALSE);
	ELSIF NOT _timerSliderInBackPos.Q THEN 
		_Text.ClearVars();
		_Text.AddVar(Text:= _automaticSliderInBackPositionName);
		_updateHmiText(
			userMessage		:= _Text.GetText(Number:= _E_TextCommon.waitSliderInBackPosition),
			userAction		:= _Text.GetText(Number:= _E_TextCommon.waitForSensor_0),
			isErrorMessage	:= FALSE);	
	ELSE 
		_SubStep.set(request:= _SUB_ADDRESS_PASS);
	END_IF	
END_IF
//(* Lock *)
//IF _SubStep.isActive(4) THEN
//	IF _SliderLockingCylinderFrontPosition.moveTo_B() THEN
//		_SubStep.set(request:= _SUB_ADDRESS_PASS);
//	ELSIF _SliderLockingCylinderFrontPosition.Error.active THEN
//		_addressRestart:= _SubStep.actual;
//		_getCylinderErrorTexts(Cylinder:= _SliderLockingCylinderFrontPosition);
//		_SubStep.set(request:= _SUB_ADDRESS_RETRY_ABORT);
//	ELSE
//		_updateHmiTextWithCylinderTextMoveToWP(Cylinder:= _SliderLockingCylinderFrontPosition);
//	END_IF
//END_IF
(* Pass *)
IF _SubStep.isActive(_SUB_ADDRESS_PASS) THEN
	_step.Condition:= TRUE;
END_IF
(* Fail *)
IF _SubStep.isActive(_SUB_ADDRESS_RETRY_ABORT) THEN
	_retryAbort(
		numOfTargetRetries	:= _UNLIMITED_RETRY_NUMBER,
		retryAddress		:= _addressRestart,
		abortAddress		:= _ADDRESS_RUNOUT);
END_IF

_step.Control();]]></ST>
      </Implementation>
    </Method>
    <Property Name="sliderInBackPositionName" Id="{9aeed47a-f5fc-44f5-ae43-d113627e8105}" FolderPath="Property \">
      <Declaration><![CDATA[PROPERTY sliderInBackPositionName : KOSTAL_AF2024_Core_Settings.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{acc0faab-2049-4087-bfce-8b7091aa5e36}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[sliderInBackPositionName:= _automaticSliderInBackPositionName;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c6c1b096-e57d-4bf9-8d51-2efa007dab99}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_automaticSliderInBackPositionName:= sliderInBackPositionName;]]></ST>
        </Implementation>
      </Set>
    </Property>
