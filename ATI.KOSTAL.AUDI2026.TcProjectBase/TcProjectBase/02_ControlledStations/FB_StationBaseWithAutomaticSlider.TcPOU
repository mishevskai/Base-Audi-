      <Declaration><![CDATA[PROPERTY sliderInFrontPositionName : KOSTAL_AF2024_Core_Settings.T_MaxString]]></Declaration>
      <Get Name="Get" Id="{cb52aa9e-46bc-4784-ba11-add9848f10f0}">
