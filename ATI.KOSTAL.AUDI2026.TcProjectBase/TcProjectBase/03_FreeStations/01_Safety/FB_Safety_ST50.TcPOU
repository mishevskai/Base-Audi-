<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Safety_ST50" Id="{21937cea-4b29-4401-b006-79c55f08bfdc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Safety_ST50 EXTENDS FB_SafetyBase
VAR
	(* Safety I&O *)
//	SI_GroupComError	AT %I* : BOOL;
//	SI_GroupFbError		AT %I* : BOOL;
//	SI_SafetyRealyInFault 			AT %I* : BOOL;
//	SO_RunSafety		AT %Q* : BOOL;
//	SO_ErrorAckSafety	AT %Q* : BOOL;
//	SO_ResetSafetyExistingSt		AT %Q* : BOOL;//DO5 20DO1
	SI_EstopOk			AT %I* : BOOL;
	SI_FrontDoorOk		AT %I* : BOOL;
	SI_BackDoorOk		AT %I* : BOOL;
	SO_GroupRun						AT %Q* : BOOL:= TRUE;
//	SO_GroupErrorAck	AT %Q* : BOOL;
//	SO_EStopRestart		AT %Q* : BOOL;
	SO_RestartSaferyRelay		AT %Q* 				   : BOOL; 
//	SI_FrontDoorOk						   : BOOL;
//	SI_BackDoorOk						   : BOOL;
	(* I&O *)
	DO_FrontDoorLock				AT %Q* : BOOL;
	DO_BackDoorLock					AT %Q* : BOOL;
	_timerEstopFault					   : Tc2_Standard.TON;
	_timerFrontDoorFault				   : Tc2_Standard.TON;
	_timerBackDoorFault					   : Tc2_Standard.TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_handleSafety" Id="{58d59990-1274-499d-abe6-19c8f38168b4}">
      <Declaration><![CDATA[METHOD PROTECTED _handleSafety 
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//_eStop();


_timerEstopFault(
	IN:=  SI_EstopOk, //AND NOT SO_RestartSaferyRelay,
	PT:= T#100MS);
_timerFrontDoorFault(
	IN:= SI_FrontDoorOk,
	PT:= T#100MS);
_timerBackDoorFault(
	IN:= SI_BackDoorOk,
	PT:= T#100MS);


//IF SI_GroupComError THEN
//	_message.clear();
//	_message.line_01:= _Text.GetText(Number:= _E_Text.errorGroupCom);
//	_condition.setMessage(
//		priority:= _condition.PriorityLevel_Error,
//		message	:= _message);
IF _timerEstopFault.Q THEN
	_Text.ClearVars();
	_Text.AddVar(Text:= "11SA1"); //Check Eplan
	_message.clear();
	_message.line_01:= _Text.GetText(Number:= _E_Text.errorEStop_0);
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
ELSIF _timerFrontDoorFault.Q THEN
	_Text.ClearVars();
	_Text.AddVar(Text:= "11SQ1");
	_message.clear();
	_message.line_01:= _Text.GetText(Number:= _E_Text.errorDoor_0);
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
ELSIF _timerBackDoorFault.Q THEN
	_Text.ClearVars();
	_Text.AddVar(Text:= "11SQ2");
	_message.clear();
	_message.line_01:= _Text.GetText(Number:= _E_Text.errorDoor_0);
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
	
	
//ELSIF SI_GroupFbError THEN
//	_message.clear();
//	_message.line_01:= _Text.GetText(Number:= _E_Text.errorGroupFb);
//	_condition.setMessage(
//		priority:= _condition.PriorityLevel_Error,
//		message	:= _message);
END_IF

//SO_RunSafety:= TRUE;
//SO_ErrorAckSafety:= _Hmi_station.Button_Escape.Sign;
//SO_ResetSafetyExistingSt:= SO_ErrorAckSafety; //Da se proveri dali ova vaka kje raboti 
SO_RestartSaferyRelay:= _Hmi_station.Button_Escape.Sign; //HMI restart 
DO_FrontDoorLock:= _doorLock;
DO_BackDoorLock:= _doorLock;
//_doorLock:= SI_FrontDoorOk;
_isDoorSafe:= DO_BackDoorLock AND DO_FrontDoorLock;
_isDoorUsed:= TRUE;]]></ST>
      </Implementation>
    </Method>
