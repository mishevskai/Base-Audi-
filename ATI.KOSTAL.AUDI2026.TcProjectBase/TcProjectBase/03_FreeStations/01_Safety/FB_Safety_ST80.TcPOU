<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Safety_ST80" Id="{13fb02b6-9278-4a2d-8da5-bf37785e9d0d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Safety_ST80 EXTENDS FB_SafetyBase
VAR
	(* Safety I&O *)
	DI_SafetyRelayInFault 	AT %I* : BOOL;
//	SI_GroupComError	AT %I* : BOOL;
//	SI_GroupFbError		AT %I* : BOOL;
//	SI_SafetyRealyInFault AT %I* : BOOL;
	SI_EstopOk			AT %I* : BOOL;
//	SI_FrontDoorOk		AT %I* : BOOL;
	SO_GroupRun			AT %Q* : BOOL:= TRUE;
//	SO_GroupErrorAck	AT %Q* : BOOL;
//	SO_EStopRestart		AT %Q* : BOOL;
	SO_EStopRestart				: BOOL;
	SO_ResetSafetyExistingSt	AT %Q*	: BOOL; //DO5 20DO1
	SI_FrontDoorOk				: BOOL;
	(* I&O *)
	DO_FrontDoorLock	AT %Q* : BOOL;
	_timerEstopFault	: Tc2_Standard.TON;
	_timerDoorFault		: Tc2_Standard.TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_handleSafety" Id="{6725c9e0-0412-41d7-94d7-fbf38b05fd73}">
      <Declaration><![CDATA[METHOD PROTECTED _handleSafety 
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_timerEstopFault(
	IN:= NOT SI_EstopOk,
	PT:= T#100MS);
_timerDoorFault(
	IN:= NOT DO_FrontDoorLock,
	PT:= T#100MS);

IF _timerEstopFault.Q THEN
	_Text.ClearVars();
	_Text.AddVar(Text:= "-15S1");
	_message.clear();
	_message.line_01:= _Text.GetText(Number:= _E_Text.errorEStop_0);
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
ELSIF _timerDoorFault.Q THEN
	_Text.ClearVars();
	_Text.AddVar(Text:= "-15S2");
	_message.clear();
	_message.line_01:= _Text.GetText(Number:= _E_Text.errorDoor_0);
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
ELSIF DI_SafetyRelayInFault THEN 
	_Text.ClearVars();
	_Text.AddVar(Text:= "-15U1");
	_message.clear();
	_message.line_01:= "-15U1 Relay in fault";
	_condition.setMessage(
		priority:= _condition.PriorityLevel_Error,
		message	:= _message);
	

END_IF

SO_ResetSafetyExistingSt:= _Hmi_station.Button_Escape.Sign; //HMI restart 
DO_FrontDoorLock:= _doorLock;
_doorLock:= DO_FrontDoorLock;
_isDoorSafe:= DO_FrontDoorLock;
_isDoorUsed:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_Safety_ST80">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_Safety_ST80._handleSafety">
      <LineId Id="79" Count="5" />
      <LineId Id="92" Count="16" />
