      <LineId Id="109" Count="0" />
      <LineId Id="132" Count="0" />
      <LineId Id="110" Count="0" />
      <LineId Id="117" Count="0" />
      <LineId Id="119" Count="3" />
      <LineId Id="124" Count="0" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>