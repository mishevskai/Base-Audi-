      <LineId Id="90" Count="0" />
      <LineId Id="44" Count="1" />
      <LineId Id="85" Count="0" />
      <LineId Id="58" Count="0" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>